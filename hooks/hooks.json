{
  "description": "claude-recall session tracking hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/session-start.js"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/prompt-submit.js"
            ]
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/cwd-changed.js"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/trigger-refinement.js"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/trigger-refinement.js"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/trigger-refinement.js"
            ]
          }
        ]
      }
    ]
  }
}
